        BEGIN
            VALUE "CompanyName", "Dragonkin Mod Loader"
            VALUE "FileDescription", "Dragonkin Mod Loader (loaded by the game as dwmapi.dll, forwards to the system dwmapi.dll)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "DragonkinModLoader"
            VALUE "LegalCopyright", "Open source mod for Dragonkin: The Banished"
            VALUE "OriginalFilename", "dwmapi.dll"
            VALUE "ProductName", "Dragonkin Mod Loader"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
